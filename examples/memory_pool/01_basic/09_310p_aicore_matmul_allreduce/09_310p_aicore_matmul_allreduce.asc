/* 09_310p_aicore_matmul_allreduce — 310P 单卡双 die 2-rank TP matmul all-reduce 融合示例
 *
 * 场景(DESIGN.md):
 *   K 维切分 TP=2: 各 rank 持 A_half[M,K/2]/B_half[K/2,N](M 默认 2048, -DEX_MVAL=4096 可选),
 *   AICore matmul 产部分和 C[M,N] → clean + GM 邮箱委托 AICPU 编排 SDMA 互传
 *   → FP16 向量累加(UB) → 双端各得完整 C = A[M,K]×B[K,N](FP16)。
 *
 * 与 08 示例的关系: 08 是 pattern 产消(r0 产/r1 INC), 09 是对称双产双收的真 TP 语义,
 * chunks 由 pattern 数据改为 matmul 计算结果, 计算与通信在 chunk 粒度重叠。
 *
 * 三模式(同 kernel, mode 参数):
 *   0=fused  单向同步生产环: 算完一块即通知搬运一块, 计算不等到达通知直接下一拍
 *            (传输与计算结构性重叠); 全部生产结束后统一归约(逐 chunk poll+累加)
 *   1=serial bulk 整体串行: 算完全部→统一 notify→逐 chunk poll+累加(零重叠基线)
 *   2=pure   仅 matmul 无通信(纯计算基线)
 *
 * 梯度扫描: chunk=1MB/512KB/256KB/128KB(沿 M 切 256/128/64/32 行, chunks=M/行数
 * 运行时推导, >64 槽自动跳档), 每配置 3 次取平均, 输出 Tserial/Tfused 加速比与
 * Tpure/Tfused 掩盖度, 测出最佳划分。
 *
 * 验收: 每档 fused/serial 首轮全量校验(CPU FP64 参考, atol=0.1+rtol=1e-2) mismatch=0,
 * kernel 状态走满(0xC1/0xB1/0xA1), 双端 PASS 干净退出。
 */
#include <chrono>   // 计时(steady_clock)
#include <cmath>    // fabs
#include <cstdio>   // printf
#include <cstdlib>  // malloc/free
#include <cstdint>  // 定宽整型
#include <mpi.h>    // MPI(双 rank 拉起/栅栏, mpirun -np 2)
#include "acl/acl.h"    // ACL 运行时(初始化/流/内存)
#include "acl/acl_rt.h" // aclrt* 接口
#include "kernel_operator.h" // AscendC 原语(dcci/GlobalTensor/向量 Add)
#include "lib/matmul_intf.h" // AscendC Matmul 高层 API(dav-2002)
#include "smem.h"     // smem_init/uninit
#include "smem_shm.h" // SHM API(建池/overlap 族)
#include "smem_shm_aicore_overlap.h" // 设备侧协同原语(notify/poll_flag)

#define STORE_URL "tcp://127.0.0.1:8582" /* 配置存储地址(与 08 错开端口) */
#ifndef EX_MVAL                            /* 每 rank A 行数(输入矩阵 A_half=[EX_MVAL,KPAD]) */
#define EX_MVAL 2048u                       /* 默认 2048; 4096 档编译追加 -DEX_MVAL=4096 */
#endif
#define EX_M EX_MVAL                        /* C 行数(= A_half 行数) */
#define EX_N 2048u                          /* C 列数(= B_half 列数) */
#ifndef EX_KVAL                             /* 每 rank 真实 K 半长(host 数据/参考计算用) */
#define EX_KVAL 2048u                       /* 默认 2048(K 全长 4096) */
#endif
#if EX_KVAL == 2048u
#define EX_KPAD 2048u /* 对齐 K 半长(设备布局/tiling 用; 2048 天然对齐) */
#elif EX_KVAL == 8196u
#define EX_KPAD 8320u /* 8196 零填充至 8320(130x64 整块; 原生非对齐 K 尾块路径实测丢尾块) */
#else
#error "EX_KVAL must be 2048 or 8196"
#endif
#define EX_KFULL (2u * EX_KVAL)             /* K 全长(A_full/B_full 生成用) */
#define EX_A_BYTES (static_cast<uint64_t>(EX_M) * EX_KPAD * 2u)   /* A 半阵字节(M×KPAD) */
#define EX_B_BYTES (static_cast<uint64_t>(EX_KPAD) * EX_N * 2u)   /* B 半阵字节(KPAD×N, 与 M 无关) */
#define EX_C_BYTES (static_cast<uint64_t>(EX_M) * EX_N * 2u)     /* C/recv 字节 */
#define EX_A_OFF 0x0000000UL                /* 段内 A_half 偏移 */
#define EX_B_OFF (EX_A_OFF + EX_A_BYTES)    /* 段内 B_half 偏移 */
#define EX_C_OFF (EX_B_OFF + EX_B_BYTES)    /* 段内 C 部分和偏移(matmul 写+SDMA 发送源) */
#define EX_RECV_OFF (EX_C_OFF + EX_C_BYTES) /* 段内接收区偏移(对端部分和镜像) */
/* 池大小: 64/128MB 两档(实测 48MB 非幂池致保留区 SQE 写失败/orchestrator 超时, 幂值池稳定) */
#define EX_POOL_NEED (EX_RECV_OFF + EX_C_BYTES + 2UL * 1024UL * 1024UL)
#define EX_LOCAL_SIZE ((EX_POOL_NEED) > (64UL * 1024UL * 1024UL) ? (128UL * 1024UL * 1024UL) : (64UL * 1024UL * 1024UL))
#define EX_MODE_FUSED 0u                    /* 融合流水模式 */
#define EX_MODE_SERIAL 1u                   /* 严格两阶段非融合基线 */
#define EX_MODE_PURE 2u                     /* 纯计算模式 */
#define EX_GRADS 4u                         /* chunk 粒度梯度档数 */
#define EX_ITERS 3u                         /* 每配置性能测量迭代数(取平均) */
#define EX_RUN_SLOTS 64u                    /* 每 runId 到达标志槽跨度(轮次隔离) */
#define EX_ACC_BLOCK_HALFS 8192u            /* 向量累加分块(16KB/块, scratch 3 段共 48KB) */
#define EX_ATOL 0.1                         /* 校验绝对容差(FP16 两次舍入裕量) */
#define EX_RTOL 0.01                        /* 校验相对容差 */

static int g_rank = -1; /* 本进程 rank(0/1) */
static int g_overall = 1; /* 总判定(1=PASS; 校验失配置 0, 不中断扫描以收集完整诊断) */

/* 梯度表: chunk 字节 → 每 chunk 行数 → chunk 数(沿 M 切, 行主序连续, SDMA 直传)
 * chunk 数运行时推导 = EX_M / 行数(M=4096 时 128KB 档为 128 chunk > 64 槽, 扫描时自动跳过) */
static const uint32_t g_gradBytes[EX_GRADS] = {1024u * 1024u, 512u * 1024u, 256u * 1024u, 128u * 1024u};
static const uint32_t g_gradRows[EX_GRADS] = {256u, 128u, 64u, 32u};

static uint32_t ExGradChunks(uint32_t g) // 本档 chunk 数(EX_M 行按档位行数均分)
{
    return EX_M / g_gradRows[g]; // 沿 M 均分(整除: 各档行数均为 EX_M 约数)
}

/* ============================ AICore kernel(设备头原语) ============================ */
#define EX_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__ /* AICore 内联属性 */

using ExAT = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half, false>; /* A 类型 */
using ExBT = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half, false>; /* B 类型 */
using ExCT = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half, false>; /* C 类型 */
using ExMm = AscendC::Matmul<ExAT, ExBT, ExCT>;      /* Matmul 对象类型(全程单实例复用) */

/* 按档位填官方 tiling(离线 matmul_tiling::MatmulApiTiling@ASCEND310P 生成值:
 * M=rows N=2048 K=EX_KPAD, A/B/C=GM/ND/FP16; stepM=stepN=1, dbL0A/B/C=2/2/1 四档恒定) */
EX_AICORE_INLINE void ExTilingInit(AscendC::tiling::TCubeTiling *t, uint32_t rows)
{
    int32_t dA1 = 0;   // A1 深度(档位相关)
    int32_t dB1 = 0;   // B1 深度(档位相关)
    int32_t sKa = 0;   // A 的 K 预取步(档位相关)
    int32_t sKb = 0;   // B 的 K 预取步(档位相关)
    int32_t transLen = 0;  // ND 转换空间(档位相关)
    int32_t shL1 = 0;      // L1 切分尺寸(档位相关)
    int32_t shUb = 0;      // UB 切分尺寸(档位相关)
    int32_t iterOrd = 0;   // 迭代序(档位相关)
#if EX_KPAD == 2048u
    if (rows == 256u) {    // 1MB 档
        dA1 = 8; dB1 = 2; sKa = 4; sKb = 1; transLen = 139264; shL1 = 327680; shUb = 131072; iterOrd = 0;
    } else if (rows == 128u) { // 512KB 档
        dA1 = 16; dB1 = 4; sKa = 8; sKb = 2; transLen = 135168; shL1 = 393216; shUb = 65536; iterOrd = 0;
    } else if (rows == 64u) {  // 256KB 档
        dA1 = 32; dB1 = 8; sKa = 32; sKb = 4; transLen = 264192; shL1 = 524288; shUb = 32768; iterOrd = 1;
    } else {                    // 128KB 档(32 行)
        dA1 = 32; dB1 = 8; sKa = 32; sKb = 4; transLen = 139264; shL1 = 393216; shUb = 16384; iterOrd = 1;
    }
#else /* EX_KPAD == 8320 (K=8196 零填充档) */
    if (rows == 256u) {    // 1MB 档
        dA1 = 10; dB1 = 2; sKa = 5; sKb = 1; transLen = 163840; shL1 = 393216; shUb = 131072; iterOrd = 0;
    } else if (rows == 128u) { // 512KB 档
        dA1 = 26; dB1 = 2; sKa = 13; sKb = 1; transLen = 212992; shL1 = 491520; shUb = 65536; iterOrd = 0;
    } else if (rows == 64u) {  // 256KB 档
        dA1 = 52; dB1 = 2; sKa = 26; sKb = 1; transLen = 212992; shL1 = 491520; shUb = 32768; iterOrd = 0;
    } else {                    // 128KB 档(32 行)
        dA1 = 52; dB1 = 4; sKa = 26; sKb = 2; transLen = 106496; shL1 = 344064; shUb = 16384; iterOrd = 0;
    }
#endif
    t->usedCoreNum = 1;                            // 单 block
    t->M = static_cast<int32_t>(rows);             // 本 chunk 全 M
    t->N = static_cast<int32_t>(EX_N);             // 全 N
    t->Ka = static_cast<int32_t>(EX_KPAD);         // A 的 K(对齐后)
    t->Kb = static_cast<int32_t>(EX_KPAD);         // B 的 K(对齐后)
    t->singleCoreM = static_cast<int32_t>(rows);   // 单核 M = chunk 行数
    t->singleCoreN = static_cast<int32_t>(EX_N);   // 单核 N
    t->singleCoreK = static_cast<int32_t>(EX_KPAD); // 单核 K
    t->baseM = static_cast<int32_t>(rows);         // 基块 M(官方: = singleCoreM)
    t->baseN = 256;                                // 基块 N(官方)
    t->baseK = 64;                                 // 基块 K(官方)
    t->depthA1 = dA1;                              // A1 深度(官方)
    t->depthB1 = dB1;                              // B1 深度(官方)
    t->stepM = 1;                                  // M 预取步(官方恒 1)
    t->stepN = 1;                                  // N 预取步(官方恒 1)
    t->stepKa = sKa;                               // A 的 K 预取步(官方)
    t->stepKb = sKb;                               // B 的 K 预取步(官方)
    t->isBias = 0;                                 // 无 bias
    t->transLength = transLen;                     // ND 转换空间(官方)
    t->iterateOrder = iterOrd;                     // 迭代序(官方)
    t->shareMode = 0;                              // 保留(官方 0)
    t->shareL1Size = shL1;                         // L1 切分尺寸(官方)
    t->shareUbSize = shUb;                         // UB 切分尺寸(官方)
    t->dbL0A = 2;                                  // A 双缓冲(官方)
    t->dbL0B = 2;                                  // B 双缓冲(官方)
    t->dbL0C = 1;                                  // C 双缓冲(官方)
}

EX_AICORE_INLINE void ExStatusSet(__gm__ uint32_t *status, uint32_t slot, uint32_t val)
{
    status[slot] = val; // 写状态槽
    AscendC::GlobalTensor<int32_t> stGm; // GM 张量(供 cache 指令寻址)
    stGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(status + slot), 1); // 绑定该槽
    AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(stGm); // 单行 dcci 刷出
}

EX_AICORE_INLINE void ExCleanRegion(__gm__ uint32_t *base, uint64_t words) // 大块数据 clean
{
    AscendC::GlobalTensor<int32_t> gm; // GM 张量(供 cache 指令寻址)
    gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(base), words); // 绑定整块数据
    AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::ENTIRE_DATA_CACHE>(gm); // 大块 clean(SDMA 可见)
}

/* 计算一个 chunk: A_half 行块[rows×K] × B_half[K×N] → C 行块[rows×N]
 * (IterateAll 在 dav-2002 入口做 ENTIRE dcci, 逐 fragment GetTensorC 直写 GM) */
EX_AICORE_INLINE void ExMatmulChunk(ExMm &mm, AscendC::GlobalTensor<half> &aGm, AscendC::GlobalTensor<half> &bGm,
                                    AscendC::GlobalTensor<half> &cGm, __gm__ half *aBase, __gm__ half *bBase,
                                    __gm__ half *cBase, uint32_t chunkIdx, uint32_t rows)
{
    const uint64_t rowOff = static_cast<uint64_t>(chunkIdx) * rows; // 本 chunk 行偏移
    aGm.SetGlobalBuffer(aBase + rowOff * EX_KPAD, static_cast<uint64_t>(rows) * EX_KPAD); // A 行块
    bGm.SetGlobalBuffer(bBase, static_cast<uint64_t>(EX_KPAD) * EX_N);                 // B 全量
    cGm.SetGlobalBuffer(cBase + rowOff * EX_N, static_cast<uint64_t>(rows) * EX_N); // C 行块
    mm.SetTensorA(aGm); // 换 A 行块(内部 Scheduler Reset, 逐 chunk 复用)
    mm.SetTensorB(bGm); // B 固定
    mm.IterateAll(cGm); // 计算并 copy-out 到 GM
}

/* 发送一个 chunk: clean(对 SDMA 可见) + 邮箱委托 AICPU 代投 SQE */
EX_AICORE_INLINE void ExNotifyChunk(__gm__ uint8_t *mb, uint32_t c, __gm__ half *cChunk, uint64_t chunkWords)
{
    ExCleanRegion(reinterpret_cast<__gm__ uint32_t *>(cChunk), chunkWords); // clean 后 SDMA 可见
    smem_shm_overlap_notify(mb + c * SMEM_SHM_OVERLAP_WS_MAILBOX_SLOT_SIZE, // 邮箱第 c 块
                            reinterpret_cast<uint64_t>(cChunk), chunkWords);
}

/* 向量累加一个 chunk: recv = partial + recv(接收区原地求和, GM↔UB 向量 Add)。
 * - scratch 借 matmul LocalWorkspace(整段 UB)头部: 二者时序串行(IterateAll 返回后累加才执行),
 *   分时复用零额外分配(UB 256KB 总量不容两份);
 * - 手动事件同步(MTE2_V/V_MTE3/MTE3_MTE2), 照 matmul 内部 CopyND2NZ 同款模式;
 * - C 部分和是 SDMA 发送源不可写(竞争), 终态落 recv 原地(非发送源, host 校验读 recv)。 */
EX_AICORE_INLINE void ExAccumulateVec(AscendC::LocalTensor<half> ub, AscendC::GlobalTensor<half> &cGm,
                                      AscendC::GlobalTensor<half> &rGm, uint64_t halfs)
{
    for (uint64_t off = 0; off < halfs; off += EX_ACC_BLOCK_HALFS) { // 逐 16KB 块
        const uint32_t n = static_cast<uint32_t>(halfs - off < EX_ACC_BLOCK_HALFS ? halfs - off
                                                                                 : EX_ACC_BLOCK_HALFS);
        auto e2v = GetTPipePtr()->FetchEventID(AscendC::HardEvent::MTE2_V); // MTE2→V 事件
        AscendC::DataCopy(ub, cGm[off], n);                                     // partial 块入 UB
        AscendC::DataCopy(ub[EX_ACC_BLOCK_HALFS], rGm[off], n);                // recv 块入 UB
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(e2v);                      // 源数据就绪
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(e2v);                      // 等 MTE2 完成
        AscendC::Add(ub, ub, ub[EX_ACC_BLOCK_HALFS], n);                        // 向量 FP16 加
        auto vm3 = GetTPipePtr()->FetchEventID(AscendC::HardEvent::V_MTE3);     // V→MTE3 事件
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(vm3);                      // 计算完成
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(vm3);                      // 等向量完成
        AscendC::DataCopy(rGm[off], ub, n);                                     // 结果写回 recv
        auto m32 = GetTPipePtr()->FetchEventID(AscendC::HardEvent::MTE3_MTE2);  // MTE3→MTE2 事件
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(m32);                   // 写回完成
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(m32);                   // 等 MTE3(防下块复用)
    }
}

/* 轮询到达并累加一个 chunk: poll 标志 → invalidate 接收区(丢弃 L1 旧行) →
 * recv = partial + recv(向量) → clean。返回非零标志值=成功, 0=超时(已记 0xEE) */
EX_AICORE_INLINE uint64_t ExPollAccumulate(AscendC::LocalTensor<half> ub, __gm__ uint64_t *flagArrival, uint32_t c,
                                           __gm__ half *cChunk, __gm__ half *rChunk, uint64_t chunkHalfs,
                                           uint64_t chunkWords, __gm__ uint32_t *status)
{
    uint64_t iters = 0; // 轮询迭代数
    uint64_t v = smem_shm_overlap_poll_flag(reinterpret_cast<__gm__ void *>(flagArrival + c), &iters);
    if (v == 0) {       // 第 c 块到达超时
        ExStatusSet(status, 0, 0xEEu); /* chunk c 到达超时 */
        return 0;       // 失败标记
    }
    status[1] = status[1] + static_cast<uint32_t>(iters & 0xFFFFFFFFu); // 累计轮询迭代数(诊断)
    AscendC::GlobalTensor<int32_t> rgm; // GM 张量(供 cache 指令寻址)
    rgm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(rChunk), chunkWords); // 绑定接收块
    AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::ENTIRE_DATA_CACHE>(rgm); // 失效取新值
    AscendC::GlobalTensor<half> cGm; // C 行块张量视图
    AscendC::GlobalTensor<half> rGm; // 接收块张量视图
    cGm.SetGlobalBuffer(cChunk, chunkHalfs); // 绑定 C 行块
    rGm.SetGlobalBuffer(rChunk, chunkHalfs); // 绑定接收块
    ExAccumulateVec(ub, cGm, rGm, chunkHalfs); // 向量累加(recv 原地)
    ExCleanRegion(reinterpret_cast<__gm__ uint32_t *>(rChunk), chunkWords); // clean 后 host D2H 可见
    return v; // 成功返回标志值
}

/* pure 模式主体: 仅逐 chunk matmul(纯计算基线, 不占邮箱/标志槽) */
EX_AICORE_INLINE void ExRunPure(ExMm &mm, AscendC::GlobalTensor<half> &aGm, AscendC::GlobalTensor<half> &bGm,
                                AscendC::GlobalTensor<half> &cGm, __gm__ half *aBase, __gm__ half *bBase,
                                __gm__ half *cBase, uint32_t rows, uint32_t chunks)
{
    for (uint32_t c = 0; c < chunks; c++) { // 逐 chunk matmul
        ExMatmulChunk(mm, aGm, bGm, cGm, aBase, bBase, cBase, c, rows);
    }
    mm.End(); // 释放 matmul 资源
}

/* serial 模式主体: 严格两阶段非融合基线(阶段一纯 matmul 全部完成 → 阶段二 allreduce:
 * 统一发描述符 → 链路传输 → 逐 chunk poll+累加), 保证 Tserial = Tmatmul + Tallreduce
 * 纯净加法, 与 fused 对比即"融合 vs 非融合" */
EX_AICORE_INLINE uint32_t ExRunSerial(ExMm &mm, AscendC::GlobalTensor<half> &aGm, AscendC::GlobalTensor<half> &bGm,
                                      AscendC::GlobalTensor<half> &cGm, __gm__ uint8_t *mb, __gm__ half *aBase,
                                      __gm__ half *bBase, __gm__ half *cBase, __gm__ half *rBase,
                                      __gm__ uint64_t *flagArrival, uint64_t rowHalfs, uint32_t rows,
                                      uint32_t chunks, uint64_t chunkWords, __gm__ uint32_t *status,
                                      AscendC::LocalTensor<half> ub)
{
    for (uint32_t c = 0; c < chunks; c++) { // 阶段一: 纯 matmul(全部算完, 无任何通信)
        ExMatmulChunk(mm, aGm, bGm, cGm, aBase, bBase, cBase, c, rows);
    }
    for (uint32_t c = 0; c < chunks; c++) { // 阶段二开启: 统一发描述符(allreduce 才开始)
        ExNotifyChunk(mb, c, cBase + c * rowHalfs, chunkWords);
    }
    for (uint32_t c = 0; c < chunks; c++) { // 再逐 chunk 收+累加
        uint64_t v = ExPollAccumulate(ub, flagArrival, c, cBase + c * rowHalfs, rBase + c * rowHalfs, rowHalfs,
                                      chunkWords, status);
        if (v == 0) { // 超时已记 0xEE
            return 0xEEu; // 失败码
        }
    }
    mm.End(); // 释放 matmul 资源
    return 0xB1u; // serial 完成码
}

/* fused 模式主体(V4 口径: 单向同步生产环 + 尾部统一归约)——算完一块即通知搬运一块,
 * 计算不等任何到达通知直接进入下一拍; 全部生产结束后统一 poll+累加。
 * 传输与计算的重叠是结构性的: 描述符随算随到, 编排器在 CP1 并发派单(每 chunk 处理
 * 0.1-0.17ms << 拍长 τ_mm=0.37-0.93ms), 计算环内零阻塞点, 对 δ 任意值鲁棒
 * (δ 过大只延长尾部归约等待, 不侵蚀计算窗口);
 * 归约挪尾的代价 = N×τ_acc 暴露(单 block 纪律下本就无法与计算重叠),
 * 收益 = 每拍 δ 不再进入关键路径(V3 实测 fused−serial 由 +0.9ms 翻正)。
 * C 区为 SDMA 只读源不变; 终态仍落 recv 原地(host 校验读 recv)。 */
EX_AICORE_INLINE uint32_t ExRunFused(ExMm &mm, AscendC::GlobalTensor<half> &aGm, AscendC::GlobalTensor<half> &bGm,
                                     AscendC::GlobalTensor<half> &cGm, __gm__ uint8_t *mb, __gm__ half *aBase,
                                     __gm__ half *bBase, __gm__ half *cBase, __gm__ half *rBase,
                                     __gm__ uint64_t *flagArrival, uint64_t rowHalfs, uint32_t rows,
                                     uint32_t chunks, uint64_t chunkWords, __gm__ uint32_t *status,
                                     AscendC::LocalTensor<half> ub)
{
    for (uint32_t c = 0; c < chunks; c++) { // 生产环: 纯计算+通知, 零等待
        ExMatmulChunk(mm, aGm, bGm, cGm, aBase, bBase, cBase, c, rows); // 算当前拍
        ExNotifyChunk(mb, c, cBase + c * rowHalfs, chunkWords);         // 通知搬运当前拍
    }
    for (uint32_t c = 0; c < chunks; c++) { // 归约环: 逐 chunk poll+累加(传输早已完成)
        uint64_t v = ExPollAccumulate(ub, flagArrival, c, cBase + c * rowHalfs,
                                      rBase + c * rowHalfs, rowHalfs, chunkWords, status);
        if (v == 0) { // 超时已记 0xEE
            return 0xEEu; // 失败码
        }
    }
    mm.End();  // 释放 matmul 资源
    return 0xC1u; // fused 完成码
}

/* 对称协同 AICore kernel(双 rank 同逻辑, 无 role; 三模式状态机) */
extern "C" __global__ __aicore__ void ex09Kernel(
    __gm__ uint8_t *ownSeg,        /* 本端段基址(64MB) */
    uint64_t physSize,             /* 段物理大小(保留) */
    uint32_t mode,                 /* 0=fused 1=serial 2=pure */
    uint32_t chunks,               /* chunk 数(8/16/32/64) */
    uint32_t chunkRows,            /* 每 chunk 行数(256/128/64/32) */
    uint32_t chunkWords,           /* 每 chunk 32bit 字数(chunkBytes/4) */
    __gm__ uint8_t *workspace,     /* 协同工作区(邮箱 ring) */
    __gm__ uint64_t *flagArrival,  /* 本端到达标志数组(8B×chunks, 槽基址已折算) */
    __gm__ uint32_t *status)      /* 状态面包屑(GM 限定) */
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE); // 声明 AICore 任务类型
    if (AscendC::GetBlockIdx() != 0) {
        return; /* 单 block 纪律 */
    }
    (void)physSize; // 保留参数(段内布局全用常量偏移)
    __gm__ half *aBase = reinterpret_cast<__gm__ half *>(ownSeg + EX_A_OFF);    // A_half 基址
    __gm__ half *bBase = reinterpret_cast<__gm__ half *>(ownSeg + EX_B_OFF);    // B_half 基址
    __gm__ half *cBase = reinterpret_cast<__gm__ half *>(ownSeg + EX_C_OFF);    // C 部分和基址
    __gm__ half *rBase = reinterpret_cast<__gm__ half *>(ownSeg + EX_RECV_OFF); // 接收区基址(累加后=终态)
    __gm__ uint8_t *mb = workspace + SMEM_SHM_OVERLAP_WS_MAILBOX_OFF; // 邮箱 ring 基址
    const uint64_t rowHalfs = static_cast<uint64_t>(chunkRows) * EX_N; // 每 chunk 半字数(C/recv 空间)
    ExStatusSet(status, 0, 0xF0u); // 状态: 入口

    AscendC::TPipe pipe;                 // matmul 管线(缓冲分配)
    AscendC::TBuf<> ubBuf;               // matmul LocalWorkspace(官方姿势: 整段 UB)
    ExMm mm;                             // matmul 对象(全程复用)
    AscendC::tiling::TCubeTiling tiling; // 单核 tiling(栈上)
    AscendC::GlobalTensor<half> aGm;     // A 绑定(逐 chunk 重绑)
    AscendC::GlobalTensor<half> bGm;     // B 绑定
    AscendC::GlobalTensor<half> cGm;     // C 绑定(逐 chunk 重绑)
    ExTilingInit(&tiling, chunkRows);    // 填官方 tiling(按档位)
    mm.Init(&tiling, &pipe);             // 初始化(一次性)
    pipe.InitBuffer(ubBuf, AscendC::TOTAL_UB_SIZE); // 整段 UB 给 matmul(ND2NZ/NZ2ND 转换空间)
    mm.SetLocalWorkspace(ubBuf.Get<uint8_t>()); // dav-2002 必需(缺省转换写飞, 实测定位)
    AscendC::LocalTensor<half> accUb = ubBuf.Get<half>(); // 累加 scratch 视图(分时复用, 串行安全)
    mm.SetOrgShape(static_cast<int32_t>(chunkRows), static_cast<int32_t>(EX_N), static_cast<int32_t>(EX_KPAD));
    mm.SetTail(static_cast<int32_t>(chunkRows), static_cast<int32_t>(EX_N), static_cast<int32_t>(EX_KPAD));

    uint32_t done = 0xEEu; // 完成码(默认失败)
    if (mode == EX_MODE_PURE) { // 纯计算
        ExRunPure(mm, aGm, bGm, cGm, aBase, bBase, cBase, chunkRows, chunks);
        done = 0xA1u; // pure 完成
    } else if (mode == EX_MODE_SERIAL) { // bulk 串行
        done = ExRunSerial(mm, aGm, bGm, cGm, mb, aBase, bBase, cBase, rBase, flagArrival, rowHalfs, chunkRows,
                           chunks, chunkWords, status, accUb);
    } else { // fused 融合流水
        done = ExRunFused(mm, aGm, bGm, cGm, mb, aBase, bBase, cBase, rBase, flagArrival, rowHalfs, chunkRows,
                          chunks, chunkWords, status, accUb);
    }
    ExStatusSet(status, 0, done); // 状态: 模式终态
} // ex09Kernel 结束(三模式状态机)

/* ============================ host 侧 ============================ */
static void Step(const char *name, int32_t ret) // 步骤断言(失败即退出)
{
    if (ret != 0) { // 返回非 0
        printf("[r%d FAIL] %-28s ret=%d\n", g_rank, name, ret); // 打印失败步骤与错误码
        exit(1); // 失败退出
    }
    printf("[r%d OK]   %-28s\n", g_rank, name); // 打印成功步骤
}

static double NowMs() // 当前毫秒数(steady_clock)
{
    // 稳定时钟换算毫秒
    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
}

/* 双 rank 栅栏: 每 run 前(计时窗外)隔离跨轮覆写 hazard
 * (run N+1 本端 SDMA 写对端 recv vs 对端 run N 未完成的累加; 双方过自身 stream sync 才到栅栏) */
static void SyncPeer() // 双 rank 栅栏
{
    MPI_Barrier(MPI_COMM_WORLD); // 全体到齐才放行(单机共享内存实现, 微秒级)
}

/* 清协同工作区邮箱 ring(轮间复用, 防旧值污染编排) */
static void ResetWorkspace(void *ws)
{
    // 清 0~1024B(邮箱 ring)
    (void)aclrtMemset(ws, SMEM_SHM_OVERLAP_WS_SENTINEL_OFF, 0, SMEM_SHM_OVERLAP_WS_SENTINEL_OFF);
}

/* LCG 伪随机(确定性, 双端同种子即可各自重建完整 A/B) */
static uint32_t ExLcgNext(uint32_t *state)
{
    *state = *state * 1664525u + 1013904223u; // 数值线性同余
    return *state;                            // 返回新状态
}

/* 生成一个 U[-1,1) 的 FP16 值(量化到 half 网格, 设备/host 二进制一致) */
static __fp16 ExLcgHalf(uint32_t *state)
{
    int32_t v = static_cast<int32_t>(ExLcgNext(state) >> 16) - 32768; // [-32768, 32767]
    return static_cast<__fp16>(static_cast<double>(v) / 32768.0);     // U[-1, 1)
}

/* host 生成完整 A[M,K]/B[K,N](同种子) + 本 rank K 半紧凑缓冲
 * 出参 halfA(本 rank A 半, [M][KPAD] 零填充布局) / halfB(本 rank B 半, [KPAD][N] 零填充布局),
 * fullA/fullB 为真实 K 全长视图(供参考计算) */
static void ExGenInputs(__fp16 **halfA, __fp16 **halfB, const __fp16 **fullA, const __fp16 **fullB)
{
    const uint64_t kFull = EX_KFULL;                       // K 全长(真实)
    __fp16 *fa = static_cast<__fp16 *>(malloc(EX_M * kFull * sizeof(__fp16))); // 完整 A(真实)
    __fp16 *fb = static_cast<__fp16 *>(malloc(kFull * EX_N * sizeof(__fp16))); // 完整 B(真实)
    __fp16 *ha = static_cast<__fp16 *>(calloc(EX_M * EX_KPAD, sizeof(__fp16))); // A 半(零填充布局)
    __fp16 *hb = static_cast<__fp16 *>(calloc(EX_KPAD * EX_N, sizeof(__fp16))); // B 半(零填充布局)
    if (fa == nullptr || fb == nullptr || ha == nullptr || hb == nullptr) { // 分配失败
        printf("[r%d FAIL] gen inputs malloc fa=%p fb=%p ha=%p hb=%p\n", g_rank, (void *)fa, (void *)fb,
               (void *)ha, (void *)hb); // 失败详情(各缓冲指针)
        exit(1);                                           // 失败退出
    }
    uint32_t sa = 0x9E3779B9u; // A 种子(固定, 双端一致)
    uint32_t sb = 0x85EBCA6Bu; // B 种子(固定, 双端一致)
    for (uint64_t i = 0; i < EX_M * kFull; i++) {          // 完整 A
        fa[i] = ExLcgHalf(&sa);                            // 逐元素
    }
    for (uint64_t i = 0; i < kFull * EX_N; i++) {          // 完整 B
        fb[i] = ExLcgHalf(&sb);                            // 逐元素
    }
    const uint64_t kOff = static_cast<uint64_t>(g_rank) * EX_KVAL; // 本 rank K 起点(真实)
    for (uint64_t i = 0; i < EX_M; i++) {                  // 抽 A 半(KVAL 真实列, 其余保持 0)
        for (uint64_t j = 0; j < EX_KVAL; j++) {           // 逐行抽取
            ha[i * EX_KPAD + j] = fa[i * kFull + kOff + j]; // 复制本 rank 半(布局按 KPAD 步进)
        }
    }
    for (uint64_t k = 0; k < EX_KVAL; k++) {               // 抽 B 半(KVAL 真实行, pad 行保持 0)
        for (uint64_t j = 0; j < EX_N; j++) {              // 逐元素
            hb[k * EX_N + j] = fb[(kOff + k) * EX_N + j];  // 复制本 rank 半
        }
    }
    *halfA = ha;                   // 出参: A 半(KPAD 布局)
    *halfB = hb;                   // 出参: B 半(KPAD 布局)
    *fullA = fa;                   // 出参: 完整 A(参考计算用)
    *fullB = fb;                   // 出参: 完整 B
}

/* CPU FP64 参考: refC[i][j] = Σ_k A[i][k]×B[k][j](half 值升 FP64 累加)
 * kLen 可选 K 全长(4096, all-reduce 后校验)或 K 半长(2048, pure 部分和校验) */
static double *ExGenRef(const __fp16 *fa, const __fp16 *fb, uint64_t kLen)
{
    double *ref = static_cast<double *>(malloc(EX_M * EX_N * sizeof(double))); // 参考结果
    if (ref == nullptr) {                                        // 分配失败
        printf("[r%d FAIL] gen ref malloc\n", g_rank);           // 失败详情
        exit(1);                                                 // 失败退出
    }
    for (uint64_t i = 0; i < EX_M; i++) {                        // 逐行
        const __fp16 *arow = fa + i * kLen;                      // A 第 i 行(按 kLen 步进)
        for (uint64_t j = 0; j < EX_N; j++) {                    // 逐列
            double sum = 0.0;                                    // FP64 累加器
            for (uint64_t k = 0; k < kLen; k++) {                // K 归约
                sum += static_cast<double>(arow[k]) * static_cast<double>(fb[k * EX_N + j]); // 累加
            }
            ref[i * EX_N + j] = sum;                             // 写参考
        }
    }
    return ref;                                                  // 返回参考矩阵
}

/* 全量校验: D2H 读 C(8MB) 与 FP64 参考逐元素比对 |c-ref| ≤ atol+rtol·|ref|, 返回失配数 */
static uint32_t ExVerifyC(uint64_t cGva, const double *ref)
{
    __fp16 *hc = static_cast<__fp16 *>(malloc(EX_M * EX_N * sizeof(__fp16))); // host 读回缓冲
    if (hc == nullptr) {                                        // 分配失败
        printf("[r%d FAIL] verify malloc\n", g_rank);           // 失败详情
        return 1;                                               // 视为失配
    }
    const uint64_t bytes = EX_M * EX_N * sizeof(__fp16);        // 8MB
    if (aclrtMemcpy(hc, bytes, reinterpret_cast<void *>(cGva), bytes, ACL_MEMCPY_DEVICE_TO_HOST) !=
        ACL_SUCCESS) {                                          // D2H 全量读回
        printf("[r%d FAIL] verify D2H cGva=0x%llx bytes=%llu\n", g_rank, (unsigned long long)cGva,
               (unsigned long long)bytes);                      // 失败详情(地址与大小)
        free(hc);                                               // 释放缓冲
        return 1;                                               // 视为失配
    }
    uint32_t bad = 0;                                           // 失配计数
    for (uint64_t i = 0; i < EX_M * EX_N; i++) {                // 逐元素比对
        const double c = static_cast<double>(hc[i]);            // 设备值
        const double r = ref[i];                                // 参考值
        if (std::fabs(c - r) > EX_ATOL + EX_RTOL * std::fabs(r)) { // 超容差
            if (bad < 4u) {                                     // 首批样本(诊断)
                printf("[r%d] verify sample idx=%llu got=%f ref=%f\n", g_rank, (unsigned long long)i, c, r);
            }
            bad++;                                              // 失配计数
        }
    }
    free(hc);                                                   // 释放缓冲
    return bad;                                                 // 返回失配数
}

/* 一轮编排: 起 kernel(mode) + overlap 提交 + 双流同步, 返回该轮耗时 ms
 * runId 决定本端/对端到达标志槽基址(轮次隔离免清池内标志); pure 不占槽不 launch */
static double ExRunOneRound(smem_shm_t shm, aclrtStream stream, uint32_t mode, uint32_t chunks, uint32_t chunkRows,
                            uint64_t ownSeg, uint64_t peerSeg, uint64_t ownFlagBase, uint64_t peerFlagBase,
                            uint32_t runId, void *ws, __gm__ uint32_t *status)
{
    ResetWorkspace(ws);                                     // 清邮箱(防旧值污染)
    (void)aclrtMemset(status, 64, 0, 64);                   // 清状态面包屑
    const uint64_t slotOff = static_cast<uint64_t>(runId) * EX_RUN_SLOTS * 8; // 本轮槽偏移
    const uint64_t ownArrival = ownFlagBase + slotOff;      // 本端到达槽基址
    const uint64_t peerArrival = peerFlagBase + slotOff;    // 对端到达槽基址
    const uint32_t chunkWords = chunkRows * EX_N / 2u;      // 每 chunk 32bit 字数
    const double t0 = NowMs();                              // 计时起点
    ex09Kernel<<<1, 0, stream>>>(reinterpret_cast<uint8_t *>(ownSeg), EX_LOCAL_SIZE, mode, chunks, chunkRows,
                                 chunkWords, static_cast<uint8_t *>(ws),
                                 reinterpret_cast<uint64_t *>(ownArrival), status);
    if (mode != EX_MODE_PURE) {                             // 通信模式才编排
        void *dstGva = reinterpret_cast<void *>(peerSeg + EX_RECV_OFF); // 数据目的 = 对端接收区
        void *flagGva = reinterpret_cast<void *>(peerArrival);          // 标志目的 = 对端本轮槽
        Step("overlap_launch", smem_shm_overlap_launch(shm, dstGva, flagGva, chunks)); // 流水提交
        Step("overlap_wait", smem_shm_overlap_wait(shm));    // 等编排 kernel(AICPU)完成
    }
    Step("sync(aiCore)", aclrtSynchronizeStream(stream));    // 等 AICore kernel 完成
    return NowMs() - t0;                                    // 返回本轮耗时(ms)
}

/* 单档梯度扫描: 三模式 × EX_ITERS 次, 首轮校验(pure 对部分和参考, 其余对全量参考) */
static void ExScanGrad(smem_shm_t shm, aclrtStream stream, uint32_t g, uint64_t ownSeg, uint64_t peerSeg,
                       uint64_t ownFlagBase, uint64_t peerFlagBase, void *ws, __gm__ uint32_t *status,
                       const double *ref, const double *halfRef, double avg[3])
{
    const uint32_t chunks = ExGradChunks(g); // 本档 chunk 数(运行时按 EX_M 推导)
    if (chunks > EX_RUN_SLOTS) { // 超邮箱槽数(M=4096 的 128KB 档为 128 chunk): 本档跳过
        printf("[r%d SKIP] g=%u(%uKB) chunks=%u > slots=%u\n", g_rank, g, g_gradBytes[g] / 1024u, chunks,
               EX_RUN_SLOTS); // 跳档提示
        avg[EX_MODE_FUSED] = avg[EX_MODE_SERIAL] = avg[EX_MODE_PURE] = 0; // 置零(汇总侧识别跳档)
        return;                                           // 本档无数据
    }
    const uint32_t rows = g_gradRows[g];     // 本档每 chunk 行数
    for (uint32_t m = 0; m < 3u; m++) {      // 模式: 0=fused 1=serial 2=pure
        double sum = 0;                      // 迭代耗时累加
        for (uint32_t i = 0; i < EX_ITERS; i++) { // 迭代取平均
            SyncPeer();                      // 轮前栅栏(计时窗外, 防跨轮覆写)
            const uint32_t runId = 1u + g * 9u + m * EX_ITERS + i; // 本轮槽基(warmup 后递增)
            sum += ExRunOneRound(shm, stream, m, chunks, rows, ownSeg, peerSeg, ownFlagBase, peerFlagBase, runId, ws,
                                 status);
            uint32_t st[4] = {0};            // 状态面包屑
            (void)aclrtMemcpy(st, sizeof(st), status, sizeof(st), ACL_MEMCPY_DEVICE_TO_HOST); // D2H 读状态
            if (st[0] == 0xEEu) {            // kernel 轮询超时
                printf("[r%d FAIL] g=%u m=%u i=%u kernel poll timeout st0=0x%X\n", g_rank, g, m, i, st[0]); // 详情
                exit(1);                     // 失败退出
            }
            if (i == 0) { // 首轮全量校验(pure 对部分和参考, fused/serial 对 all-reduce 全量参考)
                const double *want = (m == EX_MODE_PURE) ? halfRef : ref; // 本模式参考
                if (m != EX_MODE_PURE) {       // 通信模式读编排诊断
                    uint32_t mainRet = 0;      // 编排 kernel 主返回码
                    uint32_t stage = 0;        // 状态机阶段
                    uint32_t headAfter = 0;    // SQ head(TSFW 消费证据)
                    Step("overlap_get_result", smem_shm_overlap_get_result(shm, &mainRet, &stage, &headAfter));
                    if (mainRet != 0) {        // 编排 kernel 失败
                        printf("[r%d FAIL] overlap mainRet=%u g=%u m=%u\n", g_rank, mainRet, g, m); // 失败详情
                        exit(1);               // 失败退出
                    }
                    printf("[r%d] g=%u m=%u stage=%u head=%u pollIters=%u\n", g_rank, g, m, stage, headAfter,
                           st[1]); // 编排诊断
                }
                const uint64_t cGva = ownSeg + ((m == EX_MODE_PURE) ? EX_C_OFF : EX_RECV_OFF); // 校验源
                const uint32_t bad = ExVerifyC(cGva, want); // 失配数
                printf("[r%d] g=%u(%uKB) m=%u verify mismatch=%u/%llu\n", g_rank, g, g_gradBytes[g] / 1024u, m, bad,
                       (unsigned long long)(EX_M * EX_N)); // 校验结果
                if (bad != 0) {              // 有失配
                    printf("[r%d FAIL] verify bad=%u g=%u m=%u (continue scan)\n", g_rank, bad, g, m); // 失败详情
                    g_overall = 0;           // 总判定置 FAIL(不中断, 收集全模式诊断)
                }
            }
        }
        avg[m] = sum / EX_ITERS;             // 本模式均耗时
    }
}

// 示例入口: mpirun -np 2 拉起, rank 由 MPI 分配
int main(int argc, char *argv[])
{
    (void)argv; /* 参数不再使用: rank 由 MPI 分配 */
    int mpiRet = MPI_Init(&argc, &argv); /* MPI 初始化(失败由 Step 统一报错) */
    MPI_Comm_rank(MPI_COMM_WORLD, &g_rank); /* 先取 rank, 步骤日志才能带 [rN] 前缀 */
    Step("MPI_Init", mpiRet); // MPI 初始化完成
    int worldSize = 0; // 进程总数暂存
    MPI_Comm_size(MPI_COMM_WORLD, &worldSize); // 读进程总数
    if (worldSize != 2) { /* 本示例固定 2-rank(同卡 die 对) */
        printf("expect exactly 2 ranks (mpirun -np 2), got %d\n", worldSize); // 规模提示
        MPI_Finalize(); // 收尾后退出
        return 1; // 规模错误退出
    }
    Step("aclInit", aclInit(nullptr) == ACL_SUCCESS ? 0 : 1); // ACL 初始化

    /* ---- 建池(SHM + SDMA 位 → 310P 协同分支, 初始化含冒烟) ---- */
    Step("smem_init", smem_init(0)); // smem 初始化
    smem_shm_config_t cfg; // SHM 配置结构
    Step("smem_shm_config_init", smem_shm_config_init(&cfg)); // 配置初始化
    cfg.startConfigStoreServer = (g_rank == 0); // r0 起配置存储
    Step("smem_shm_init", smem_shm_init(STORE_URL, 2, static_cast<uint32_t>(g_rank), // SHM 全局初始化
                                        static_cast<uint16_t>(g_rank), &cfg));
    void *gva = nullptr; // 池 GVA 出参
    smem_shm_t shm = smem_shm_create(0, 2, static_cast<uint32_t>(g_rank), EX_LOCAL_SIZE,
                                     SMEMS_DATA_OP_SDMA, 0, &gva);
    if (shm == nullptr || gva == nullptr) { // 建池失败
        printf("[r%d FAIL] smem_shm_create localSize=%llu: %s\n", g_rank, (unsigned long long)EX_LOCAL_SIZE,
               smem_get_last_err_msg()); // 错误详情(含池大小)
        return 1; // 失败退出
    }
    Step("smem_shm_create(SDMA)", 0); // 建池成功标记
    const uint64_t symSize = smem_shm_get_symmetric_size(shm); // 对称段大小
    const uint64_t ownSeg = reinterpret_cast<uint64_t>(gva) + symSize * g_rank; // 本端段基址
    const uint64_t peerSeg = reinterpret_cast<uint64_t>(gva) + symSize * (1 - g_rank); // 对端段基址
    const uint64_t ownFlagBase = ownSeg + EX_LOCAL_SIZE - 2UL * 1024UL * 1024UL; // 本端保留区基址
    const uint64_t peerFlagBase = peerSeg + EX_LOCAL_SIZE - 2UL * 1024UL * 1024UL; // 对端保留区基址
    void *ws = smem_shm_overlap_get_workspace(shm); // 协同工作区
    if (ws == nullptr) { // 协同未就绪(开关关/冒烟失败)
        printf("[r%d FAIL] overlap not ready\n", g_rank); // 失败提示
        return 1; // 失败退出
    }
    printf("[r%d INFO] gva=%p symSize=0x%llx own=0x%llx peer=0x%llx\n", g_rank, gva,
           (unsigned long long)symSize, (unsigned long long)ownSeg, (unsigned long long)peerSeg);
    printf("[r%d INFO] M=%u K=%u(full %u, pad %u) pool=%lluMB A/B=%llu/%lluMB C=%lluMB\n", g_rank, EX_M, EX_KVAL,
           EX_KFULL, EX_KPAD, (unsigned long long)(EX_LOCAL_SIZE / (1024UL * 1024UL)),
           (unsigned long long)(EX_A_BYTES / (1024UL * 1024UL)),
           (unsigned long long)(EX_B_BYTES / (1024UL * 1024UL)),
           (unsigned long long)(EX_C_BYTES / (1024UL * 1024UL))); // 池/半阵/C 尺寸

    /* ---- 资源: 状态区 + AICore 流 + host 数据(生成/参考/H2D) ---- */
    void *statusBuf = nullptr; // 状态面包屑缓冲
    if (aclrtMalloc(&statusBuf, 64, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMemset(statusBuf, 64, 0, 64) != ACL_SUCCESS) { // 分配并清零状态区
        printf("[r%d FAIL] status alloc\n", g_rank); // 分配失败
        return 1; // 失败退出
    }
    aclrtStream aiCoreStream = nullptr; // AICore 流句柄
    (void)aclrtCreateStream(&aiCoreStream); // 创建 AICore 流
    __fp16 *halfA = nullptr;               // 本 rank A 半(紧凑)
    __fp16 *halfB = nullptr;               // 本 rank B 半(视图)
    const __fp16 *fullA = nullptr;         // 完整 A(参考用)
    const __fp16 *fullB = nullptr;         // 完整 B(参考用)
    ExGenInputs(&halfA, &halfB, &fullA, &fullB); // 生成完整 A/B 与本 rank 半
    const uint64_t aBytes = EX_A_BYTES; // A 半阵字节(M×KPAD)
    const uint64_t bBytes = EX_B_BYTES; // B 半阵字节(KPAD×N)
    if (aclrtMemcpy(reinterpret_cast<void *>(ownSeg + EX_A_OFF), aBytes, halfA, aBytes,
                    ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS || // H2D A 半
        aclrtMemcpy(reinterpret_cast<void *>(ownSeg + EX_B_OFF), bBytes, halfB, bBytes,
                    ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) { // H2D B 半
        printf("[r%d FAIL] H2D inputs ownSeg=0x%llx aBytes=%llu bBytes=%llu\n", g_rank,
               (unsigned long long)ownSeg, (unsigned long long)aBytes, (unsigned long long)bBytes); // 失败详情
        return 1; // 失败退出
    }
    printf("[r%d INFO] gen FP64 ref (one-shot, ~10s)...\n", g_rank); // 参考计算提示
    const double *ref = ExGenRef(fullA, fullB, EX_KFULL);      // CPU FP64 全量参考(真实 K)
    const double *halfRef = ExGenRef(halfA, halfB, EX_KPAD);   // CPU FP64 部分和参考(pad 区 0 等价)
    SyncPeer(); /* 会合: 双方数据就绪 */

    /* ---- 预热(1 次 fused@1MB 档, 不计入统计) ---- */
    SyncPeer(); // 预热前栅栏
    (void)ExRunOneRound(shm, aiCoreStream, EX_MODE_FUSED, ExGradChunks(0), g_gradRows[0], ownSeg, peerSeg,
                        ownFlagBase, peerFlagBase, 0, ws, static_cast<uint32_t *>(statusBuf));
    SyncPeer(); // 预热后栅栏
    uint32_t warm[4] = {0}; // 预热轮状态面包屑
    (void)aclrtMemcpy(warm, sizeof(warm), statusBuf, sizeof(warm), ACL_MEMCPY_DEVICE_TO_HOST); // D2H 读状态
    if (warm[0] != 0xC1u) { // 预热未走满 fused 完成态
        printf("[r%d FAIL] warmup st0=0x%X (expect 0xC1)\n", g_rank, warm[0]); // 失败详情(实际/期望状态)
        return 1; // 失败退出
    }

    /* ---- 梯度扫描: 4 档 × (fused/serial/pure) × 3 次取平均 ---- */
    double tf[EX_GRADS] = {0}; // 各档 fused 均耗时
    double ts[EX_GRADS] = {0}; // 各档 serial 均耗时
    double tp[EX_GRADS] = {0}; // 各档 pure 均耗时
    for (uint32_t g = 0; g < EX_GRADS; g++) { // 逐档扫描
        double avg[3] = {0};                  // 本档三模式均耗时
        ExScanGrad(shm, aiCoreStream, g, ownSeg, peerSeg, ownFlagBase, peerFlagBase, ws,
                   static_cast<uint32_t *>(statusBuf), ref, halfRef, avg); // 单档扫描
        tf[g] = avg[EX_MODE_FUSED];           // 记录 fused
        ts[g] = avg[EX_MODE_SERIAL];          // 记录 serial
        tp[g] = avg[EX_MODE_PURE];            // 记录 pure
        if (tf[g] == 0) { // 跳档(Chunks 超槽, 见 ExScanGrad SKIP)
            printf("[r%d] 梯度 chunk=%uKB(%u行x%u): SKIP(chunks>%u)\n", g_rank, g_gradBytes[g] / 1024u,
                   g_gradRows[g], ExGradChunks(g), EX_RUN_SLOTS); // 跳档提示
            continue;                                     // 下一档
        }
        printf("[r%d] 梯度 chunk=%uKB(%u行x%u): Tfused=%.2f Tserial=%.2f Tpure=%.2f(ms)\n", g_rank,
               g_gradBytes[g] / 1024u, g_gradRows[g], ExGradChunks(g), tf[g], ts[g], tp[g]); // 单档耗时
        printf("[r%d]           加速比(Ts/Tf)=%.2fx 掩盖度(Tp/Tf)=%.2f\n", g_rank,
               tf[g] > 0 ? ts[g] / tf[g] : 0.0, tf[g] > 0 ? tp[g] / tf[g] : 0.0); // 单档比率
    }

    /* ---- 最佳划分(r0): 加速比最大, 并列取掩盖度更接近 1 者(跳过 tf=0 档) ---- */
    if (g_rank == 0) { // r0 汇总
        int best = -1; // 最佳档下标(-1=全跳)
        for (uint32_t g = 0; g < EX_GRADS; g++) { // 逐档比较
            if (tf[g] == 0) { // 跳档
                continue;     // 不参与
            }
            if (best < 0) { // 首个有效档
                best = static_cast<int>(g); // 记录
                continue;                    // 下一档
            }
            const double spG = ts[g] / tf[g];        // 本档加速比
            const double spB = ts[best] / tf[best]; // 当前最佳加速比
            if (spG > spB || (spG == spB && tp[g] / tf[g] > tp[best] / tf[best])) { // 更优
                best = static_cast<int>(g); // 更新最佳
            }
        }
        if (best >= 0) { // 有有效档
            printf("[r0] 最佳划分: chunk=%uKB(%u行×%u) 加速比=%.2fx 掩盖度=%.2f\n", g_gradBytes[best] / 1024u,
                   g_gradRows[best], ExGradChunks(best), ts[best] / tf[best], tp[best] / tf[best]); // 最佳划分
        }
    }

    (void)aclrtDestroyStream(aiCoreStream); // 销毁 AICore 流
    (void)aclrtFree(statusBuf); // 释放状态区
    free(halfA); // 释放 A 半缓冲
    free(halfB); // 释放 B 半缓冲
    free(const_cast<__fp16 *>(fullA)); // 释放完整 A
    free(const_cast<__fp16 *>(fullB)); // 释放完整 B
    free(const_cast<double *>(ref)); // 释放全量参考
    free(const_cast<double *>(halfRef)); // 释放部分和参考
    Step("smem_shm_destroy", smem_shm_destroy(shm, 0)); // 销毁池(协同资源计数-1)
    smem_shm_uninit(0); // SHM 反初始化
    Step("smem_shm_uninit", 0); // 标记成功
    smem_uninit(); // smem 反初始化
    Step("smem_uninit", 0); // 标记成功
    (void)aclrtResetDevice(g_rank); // 复位设备
    (void)aclFinalize(); // ACL 收尾
    printf("=== EX09 r%d %s ===\n", g_rank, g_overall ? "PASS" : "FAIL"); // 打印总判定
    MPI_Finalize(); // MPI 收尾
    return g_overall ? 0 : 1; // PASS 返回 0
}
